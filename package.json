{
  "name": "mermaid-viewer",
  "displayName": "Mermaid Diagram Editor & Viewer, Live Diagram Preview (MMD, PNG/SVG Export, Offline)",
  "description": "Free Mermaid editor with a live diagram preview: edit .mmd files and mermaid blocks in Markdown side by side, with completion, error lines, templates and PNG, SVG or PDF export. No sign-in, no AI, works offline.",
  "version": "0.2.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1E2A3A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "mermaidVersion": "12.3.0",
  "mermaidSha256": "336df803d87a38b70a01e736e666c8f7601d2ce42f5e47c8fafe5d721074b9a3",
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "mermaid pdf",
    "mermaid markdown",
    "diagram editor",
    "mermaid live editor",
    "mermaid editor",
    "mmd",
    "mermaid preview",
    "mermaid viewer",
    "mermaid diagram",
    "flowchart",
    "sequence diagram",
    "gantt",
    "mermaid export",
    "mermaid png",
    "mermaid svg",
    "offline",
    "no login",
    "class diagram",
    "state diagram",
    "er diagram",
    "mindmap",
    "gitgraph",
    "markdown",
    "diagram",
    "live preview",
    "dark mode"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:mermaid",
    "onLanguage:markdown",
    "onWebviewPanel:mermaidViewer.preview",
    "onFileSystem:mermaid-block"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./syntaxes/mermaid.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mermaidViewer.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "Mermaid Viewer",
        "icon": "$(open-preview)"
      },
      {
        "command": "mermaidViewer.showPreview",
        "title": "Open Preview",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.openEditor",
        "title": "Open Diagram Editor (Text + Live Preview)",
        "category": "Mermaid Viewer",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "mermaidViewer.newDiagram",
        "title": "New Diagram from Template",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.editBlock",
        "title": "Edit Diagram at Cursor",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.previewBlock",
        "title": "Preview This Diagram",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.exportPdf",
        "title": "Export Diagrams to PDF",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.exportWorkspace",
        "title": "Export All Diagrams in Workspace (SVG/PNG)",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.outlineReveal",
        "title": "Go to Diagram",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.outlineEdit",
        "title": "Edit Diagram",
        "category": "Mermaid Viewer",
        "icon": "$(edit)"
      },
      {
        "command": "mermaidViewer.outlinePreview",
        "title": "Preview Diagram",
        "category": "Mermaid Viewer",
        "icon": "$(open-preview)"
      },
      {
        "command": "mermaidViewer.unlockOutline",
        "title": "Unlock the Diagram Outline",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.openWalkthrough",
        "title": "Get Started",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.supportDeveloper",
        "title": "Support the developer",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.moreViewers",
        "title": "More free viewers",
        "category": "Mermaid Viewer"
      },
      {
        "command": "mermaidViewer.enterLicenseKey",
        "title": "Zovo: Enter license key"
      },
      {
        "command": "mermaidViewer.getPro",
        "title": "Zovo: Get Pro (USD 15 once, all Zovo viewers)"
      },
      {
        "command": "mermaidViewer.unlockWithSponsors",
        "title": "Zovo: Unlock Pro with GitHub Sponsors"
      },
      {
        "command": "mermaidViewer.removeLicense",
        "title": "Zovo: Remove license from this editor"
      }
    ],
    "keybindings": [
      {
        "command": "mermaidViewer.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && mermaidViewer.isMermaid"
      },
      {
        "command": "mermaidViewer.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && mermaidViewer.isMermaid"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mermaidViewer.showPreviewToSide",
          "when": "mermaidViewer.isMermaid || mermaidViewer.markdownHasMermaid || resourceExtname =~ /^\\.(mmd|mermaid)$/i",
          "group": "navigation"
        },
        {
          "command": "mermaidViewer.openEditor",
          "when": "mermaidViewer.markdownHasMermaid && !mermaidViewer.isMermaid",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "mermaidViewer.showPreviewToSide",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid)$/i",
          "group": "navigation@9"
        },
        {
          "command": "mermaidViewer.openEditor",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid)$/i",
          "group": "navigation@9"
        },
        {
          "command": "mermaidViewer.exportPdf",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid|md|markdown)$/i",
          "group": "7_modification@9"
        }
      ],
      "editor/context": [
        {
          "command": "mermaidViewer.showPreviewToSide",
          "when": "mermaidViewer.isMermaid || mermaidViewer.markdownHasMermaid",
          "group": "navigation@9"
        },
        {
          "command": "mermaidViewer.editBlock",
          "when": "mermaidViewer.markdownHasMermaid",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "mermaidViewer.showPreviewToSide",
          "when": "mermaidViewer.isMermaid || editorLangId == markdown || resourceExtname =~ /^\\.(mmd|mermaid)$/i"
        },
        {
          "command": "mermaidViewer.showPreview",
          "when": "mermaidViewer.isMermaid || editorLangId == markdown || resourceExtname =~ /^\\.(mmd|mermaid)$/i"
        },
        {
          "command": "mermaidViewer.openEditor",
          "when": "mermaidViewer.isMermaid || editorLangId == markdown || resourceExtname =~ /^\\.(mmd|mermaid)$/i"
        },
        {
          "command": "mermaidViewer.editBlock",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mermaidViewer.previewBlock",
          "when": "false"
        },
        {
          "command": "mermaidViewer.exportPdf",
          "when": "mermaidViewer.isMermaid || editorLangId == markdown || resourceExtname =~ /^\\.(mmd|mermaid)$/i"
        },
        {
          "command": "mermaidViewer.exportWorkspace",
          "when": "workbenchState != empty"
        },
        {
          "command": "mermaidViewer.outlineReveal",
          "when": "false"
        },
        {
          "command": "mermaidViewer.outlineEdit",
          "when": "false"
        },
        {
          "command": "mermaidViewer.outlinePreview",
          "when": "false"
        },
        {
          "command": "mermaidViewer.unlockOutline",
          "when": "false"
        },
        {
          "command": "mermaidViewer.enterLicenseKey",
          "when": "mermaidViewer.proEnabled"
        },
        {
          "command": "mermaidViewer.getPro",
          "when": "mermaidViewer.proEnabled"
        },
        {
          "command": "mermaidViewer.unlockWithSponsors",
          "when": "mermaidViewer.proEnabled"
        },
        {
          "command": "mermaidViewer.removeLicense",
          "when": "mermaidViewer.proEnabled"
        }
      ],
      "view/item/context": [
        {
          "command": "mermaidViewer.outlineEdit",
          "when": "view == mermaidViewer.outline && viewItem == mermaidBlock",
          "group": "inline@1"
        },
        {
          "command": "mermaidViewer.outlinePreview",
          "when": "view == mermaidViewer.outline && viewItem =~ /^mermaid(Block|File)$/",
          "group": "inline@2"
        }
      ],
      "view/title": [
        {
          "command": "mermaidViewer.exportPdf",
          "when": "view == mermaidViewer.outline",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Mermaid Viewer",
      "properties": {
        "mermaidViewer.theme": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "dark",
            "forest",
            "neutral",
            "base"
          ],
          "enumDescriptions": [
            "Follow VS Code: the dark Mermaid theme in dark editor themes, the default one in light themes.",
            "Mermaid's default theme.",
            "Mermaid's dark theme.",
            "Mermaid's forest theme.",
            "Mermaid's neutral theme, good for printing.",
            "Mermaid's base theme, the one to change with themeVariables."
          ],
          "default": "auto",
          "description": "Mermaid theme for new previews. A theme set in the diagram itself (%%{init}%% or front matter) wins. You can change it from the toolbar; that choice is kept for this workspace."
        },
        "mermaidViewer.background": {
          "type": "string",
          "enum": [
            "theme",
            "white",
            "transparent",
            "custom"
          ],
          "default": "theme",
          "description": "Background of the preview and of exported files. You can change it from the toolbar; that choice is kept for this workspace."
        },
        "mermaidViewer.customBackground": {
          "type": "string",
          "default": "#f5f5f0",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "The color used when the background is \"custom\", as #rrggbb."
        },
        "mermaidViewer.wheel": {
          "type": "string",
          "enum": [
            "auto",
            "zoom",
            "pan"
          ],
          "enumDescriptions": [
            "A mouse wheel zooms at the pointer. On a trackpad, two fingers pan and a pinch zooms.",
            "The mouse wheel and the trackpad zoom at the pointer. Drag to pan.",
            "The wheel pans. Ctrl or Cmd plus the wheel zooms, and so does a trackpad pinch."
          ],
          "default": "auto",
          "description": "What the mouse wheel and the trackpad do in the diagram view."
        },
        "mermaidViewer.updateDelayMs": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 5000,
          "description": "How long to wait after you stop typing before the preview draws the diagram again. While a big diagram is still drawing, only the newest text is drawn after it."
        },
        "mermaidViewer.maxTextSize": {
          "type": "number",
          "default": 500000,
          "minimum": 1000,
          "maximum": 20000000,
          "description": "Diagrams with more characters than this are not drawn, and the preview says so. Mermaid's own default is 50,000."
        },
        "mermaidViewer.maxEdges": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 200000,
          "description": "Diagrams with more links than this are not drawn, and the preview says so. Layout time grows fast with links: about 8 s for 2,000 and about a minute for 5,000 on a recent Mac. Raise mermaidViewer.renderTimeoutSeconds with it. Mermaid's own default is 500."
        },
        "mermaidViewer.renderTimeoutSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 300,
          "description": "A diagram that takes longer than this to draw is stopped, and the preview says so."
        },
        "mermaidViewer.languageIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "mermaid"
          ],
          "description": "Language ids that the preview treats as Mermaid, in addition to .mmd and .mermaid files. Add your own if you map other file types to Mermaid with files.associations."
        },
        "mermaidViewer.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show \"Edit diagram\" and \"Preview\" above each mermaid block in Markdown files."
        },
        "mermaidViewer.saveMarkdownOnBlockSave": {
          "type": "boolean",
          "default": true,
          "description": "When you save a diagram opened with \"Edit diagram\", also save the Markdown file, if it had no other unsaved changes. Undo in the Markdown file takes the change back either way."
        },
        "mermaidViewer.svgTextLabels": {
          "type": "boolean",
          "default": false,
          "description": "Export SVG with plain SVG text labels instead of HTML labels. Azure DevOps wikis and some image tools drop HTML labels. You can also switch it in the Export menu; that choice is kept for this workspace."
        },
        "mermaidViewer.exportFolder": {
          "type": "string",
          "default": "mermaid-export",
          "description": "Folder in the workspace for \"Export All Diagrams in Workspace\". Folders inside it follow the folders of the source files."
        },
        "mermaidViewer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a Marketplace rating after you have used Mermaid Viewer on a few days. You can answer \"Later\" or \"No thanks\". Nothing is sent anywhere."
        },
        "mermaidViewer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor and More free viewers links at the bottom of the preview. The change shows in previews you open next. Nothing is sent anywhere."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "mermaidViewer.start",
        "title": "Get started with the Mermaid editor",
        "description": "Edit Mermaid diagrams next to a live preview, in .mmd files and in Markdown, and save them as PNG, SVG or PDF. No account and no network.",
        "steps": [
          {
            "id": "open",
            "title": "Open the diagram editor",
            "description": "Open a .mmd file and run Open Diagram Editor: text on the left, live diagram on the right.\n[Open Diagram Editor](command:mermaidViewer.openEditor)\n[New Diagram from Template](command:mermaidViewer.newDiagram)",
            "media": {
              "markdown": "walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:mermaidViewer.openEditor",
              "onCommand:mermaidViewer.showPreviewToSide",
              "onCommand:mermaidViewer.newDiagram"
            ]
          },
          {
            "id": "markdown",
            "title": "Edit diagrams inside Markdown",
            "description": "Click Edit diagram above a mermaid block. Saving writes the block back into the Markdown file, and Undo there takes it back.",
            "media": {
              "markdown": "walkthrough/markdown.md"
            },
            "completionEvents": [
              "onCommand:mermaidViewer.editBlock"
            ]
          },
          {
            "id": "navigate",
            "title": "Zoom and pan",
            "description": "Scroll or pinch to zoom at the pointer, drag or use two fingers to pan. Fit and 100% are in the toolbar, and the keys 0 and 1 do the same.",
            "media": {
              "markdown": "walkthrough/navigate.md"
            }
          },
          {
            "id": "export",
            "title": "Save PNG, SVG or PDF",
            "description": "Export gives PNG at an exact width or height or at 1x, 2x or 4x, SVG with optional text labels for wikis, and PDF with a title page.",
            "media": {
              "markdown": "walkthrough/export.md"
            }
          },
          {
            "id": "settings",
            "title": "Theme, background and limits",
            "description": "Pick the Mermaid theme, the background and the size limits for big diagrams.\n[Open settings](command:workbench.action.openSettings?%5B%22mermaidViewer%22%5D)",
            "media": {
              "markdown": "walkthrough/settings.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          }
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mermaidViewer.outline",
          "name": "Mermaid Diagrams",
          "when": "mermaidViewer.isMermaid || mermaidViewer.markdownHasMermaid",
          "icon": "media/preview-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/build.js && ZOVO_SPONSORS_MODULE=$PWD/src/license/sponsors.js node --test \"test/*.test.js\"",
    "samples": "node scripts/make-samples.mjs samples",
    "package": "node scripts/build.js && npx -y @vscode/vsce package --no-dependencies -o dist/",
    "e2e": "node scripts/e2e-vscode.mjs && node scripts/e2e-editor.mjs"
  },
  "homepage": "https://github.com/theluckystrike/mermaid-viewer-vscode#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/mermaid-viewer-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/mermaid-viewer-vscode"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike"
  }
}
